# OpenAI API key. Server only; never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Model name sent to the API (for example a GPT chat model). Required for live mode.
OPENAI_MODEL=
# Optional. Override the API base URL (proxy or compatible gateway). Leave empty for OpenAI.
OPENAI_BASE_URL=
# Optional. Reasoning effort for reasoning models: minimal, low, medium or high. Invalid values are ignored.
OPENAI_REASONING_EFFORT=
# "live" calls the model through /api/review; "sample" uses the built-in sample tutor and speech.
NEXT_PUBLIC_AI_MODE=live
